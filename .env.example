# ─────────────────────────────────────────────────────────────────────────────
# OzodFlow — muhit sozlamalari
#
# Bu faylni `.env` ga nusxalang va qiymatlarni to'ldiring:
#   cp .env.example .env
#
# `.env` git'ga TUSHMAYDI. Hech qanday parol yoki kalit kodda yozilmaydi.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# Saytning to'liq manzili. OAuth qaytish manzillari, email havolalari,
# sitemap va Open Graph teglari shundan yasaladi.
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ── Database ─────────────────────────────────────────────────────────────────
# SQLite. Yo'l `prisma/schema.prisma` fayliga NISBATAN hisoblanadi,
# shuning uchun `../data/...` repo ildizidagi data/ papkasini bildiradi.
#
# Docker/Railway'da doimiy volume'ga absolyut yo'l bering:
#   DATABASE_URL="file:/data/ozodflow.db"
#
# Keyinchalik Postgres'ga o'tishda faqat shu qatorni va
# prisma/schema.prisma dagi `provider` ni o'zgartirish kifoya.
DATABASE_URL="file:../data/ozodflow.db"


# ── Auth ─────────────────────────────────────────────────────────────────────
# Har biri kamida 32 belgidan iborat TASODIFIY qiymat bo'lishi shart.
# Yasash:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Ikkalasi HAR XIL bo'lsin — access token o'g'irlansa refresh token yaramaydi.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Token yashash muddati. Access qisqa, refresh uzun.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d


# ── Birinchi super admin ─────────────────────────────────────────────────────
# Loyiha birinchi ishga tushganda shu ma'lumotlardan SUPER_ADMIN yaratiladi.
# Kirgandan keyin admin panelda email va parolni o'zgartirish mumkin.
# Parol kamida 12 belgi, katta-kichik harf va raqam bo'lsin.
OZODFLOW_ADMIN_EMAIL=
OZODFLOW_ADMIN_PASSWORD=
OZODFLOW_ADMIN_NAME="OzodFlow Admin"


# ── OTP (SMS / email bilan kirish) ───────────────────────────────────────────
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5


# ── Telegram ─────────────────────────────────────────────────────────────────
# Xabarnomalar uchun bot (@BotFather orqali olinadi)
TELEGRAM_BOT_TOKEN=
# Admin xabarnomalari tushadigan chat
TELEGRAM_ADMIN_CHAT_ID=
# "Telegram bilan kirish" uchun bot username (@ belgisiz)
TELEGRAM_LOGIN_BOT_USERNAME=


# ── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="OzodFlow <noreply@ozodflow.uz>"


# ── S3 mos keluvchi fayl saqlash ─────────────────────────────────────────────
# Lokal ishlash uchun MinIO (docker-compose ichida), production'da
# Cloudflare R2 / Backblaze B2 / AWS S3.
# Bo'sh qoldirilsa fayllar public/uploads/ ga yoziladi (faqat dev uchun).
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=ozodflow
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Fayllar ochiq ko'rinadigan manzil (CDN yoki bucket public URL)
S3_PUBLIC_URL=


# ── Platforma qoidalari ──────────────────────────────────────────────────────
# Escrow'dan platforma ushlab qoladigan foiz. Admin panelda o'zgartiriladi,
# bu faqat boshlang'ich qiymat.
PLATFORM_COMMISSION_PERCENT=15
# Minimal yechib olish summasi (so'm)
MIN_WITHDRAWAL_AMOUNT=100000
DEFAULT_CURRENCY=UZS


# ── AI funksiyalari ──────────────────────────────────────────────────────────
# Loyiha tavsifi generatori, byudjet taxmini, spam/scam aniqlash uchun.
# Bo'sh qoldirilsa AI funksiyalari o'chirilgan holda ishlaydi.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5


# ── Rate limiting ────────────────────────────────────────────────────────────
# Redis bo'lmasa xotirada ishlaydi (bitta instansiya uchun yetarli).
REDIS_URL=
