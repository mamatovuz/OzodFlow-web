# ── Lokal (kompyuterda) ──
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-to-a-long-random-string"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── POS integratsiya (Clopos, iiko, Poster ...) ──
# Kassa kredensiallari DB'da AES-256-GCM bilan shifrlanadi.
# 32 baytlik kalit (hex). Bo'lmasa JWT_SECRET'dan olinadi (prod'da alohida o'rnating).
# Yaratish: openssl rand -hex 32
POS_ENCRYPTION_KEY=""
# Avtomatik menyu sinxroni uchun (tashqi cron /api/pos/cron ni chaqiradi)
CRON_SECRET=""

# ── Instagram Automation (Meta App) ──
# instagram.com/developers → App yarating (Instagram → API setup with Instagram login).
# Talab qilinadigan ruxsatlar: instagram_business_basic,
#   instagram_business_manage_messages, instagram_business_manage_comments
IG_APP_ID=""
IG_APP_SECRET=""
# Webhook tasdiqlash uchun o'zingiz tanlagan tasodifiy satr (Meta App'da ham shu yoziladi)
IG_WEBHOOK_VERIFY_TOKEN=""
# MUHIM: Meta App'da OAuth redirect va Webhook callback uchun NEXT_PUBLIC_APP_URL
#   HTTPS domen bo'lishi shart. Callback: {APP_URL}/api/instagram/callback
#   Webhook:  {APP_URL}/api/instagram/webhook  (fields: comments, messages)

# ── Telegram bot (admin parolni tiklash uchun) ──
# @BotFather'dan token oling, @userinfobot'dan chat_id oling
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""

# ── Railway (bitta Volume /app/data ga ulangan) ──
# DATABASE_URL="file:/app/data/prod.db"
# UPLOAD_DIR="/app/data/uploads"
# JWT_SECRET="<uzun-tasodifiy-satr>"
# NEXT_PUBLIC_APP_URL="https://sizning-domeningiz.uz"
# PLATFORM_HOSTS="sizning-domeningiz.uz,www.sizning-domeningiz.uz"
