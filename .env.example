# Ma'lumotlar bazasi (SQLite)
# Lokal:
DATABASE_URL="file:./dev.db"
# Railway (Volume /app/data ga ulangan bo'lsa):
# DATABASE_URL="file:/app/data/prod.db"

# JWT maxfiy kaliti — uzun tasodifiy satr
JWT_SECRET="change-me-to-a-long-random-string"

# Ilova manzili
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Platforma domenlari (vergul bilan) — bularda landing ko'rsatiladi,
# qolgan (custom) domenlarda restoran menyusi ochiladi
# PLATFORM_HOSTS="ozodflow.uz,www.ozodflow.uz"
