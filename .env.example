# ── Lokal (kompyuterda) ──
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-to-a-long-random-string"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── POS integratsiya (Clopos, iiko, Poster ...) ──
# Kassa kredensiallari DB'da AES-256-GCM bilan shifrlanadi.
# 32 baytlik kalit (hex). Bo'lmasa JWT_SECRET'dan olinadi (prod'da alohida o'rnating).
# Yaratish: openssl rand -hex 32
POS_ENCRYPTION_KEY=""
# Avtomatik menyu sinxroni uchun (tashqi cron /api/pos/cron ni chaqiradi)
CRON_SECRET=""

# ── Mobil ilova (haqiqiy .apk) — GitHub Actions orqali quriladi ──
# Repo (owner/name). Bo'lsa "Ilova yaratish" workflow_dispatch yuboradi.
GITHUB_REPO="mamatovuz/OzodFlow-web"
# GitHub PAT — ruxsat: Actions (read/write). Fine-grained token tavsiya etiladi.
GH_DISPATCH_TOKEN=""
# Build tugagach APK ni /api/mobile-app/upload ga qaytarish uchun maxfiy kalit.
# Xuddi shu qiymatni GitHub Secret (APK_BUILD_SECRET) sifatida ham qo'shing.
# Yaratish: openssl rand -hex 24
APK_BUILD_SECRET=""
# Imzo kalitining SHA-256 barmoq izi (OMMAVIY) — TWA assetlinks uchun.
# gen-keystore workflow'i chiqaradi (masalan: AB:CD:...:12).
ANDROID_CERT_SHA256=""
# Ixtiyoriy: build qilinadigan branch (default main) va workflow fayl nomi.
# GITHUB_BRANCH="main"
# GITHUB_WORKFLOW_FILE="build-apk.yml"

# ── Google bilan kirish (OAuth 2.0) ──
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID (Web).
# "Authorized redirect URIs" ga quyidagilarni qo'shing:
#   http://localhost:3000/api/auth/google/callback   (lokal)
#   https://ozodflow.uz/api/auth/google/callback      (ishlab chiqarish)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Resend (email: tasdiqlash kodi + parol tiklash havolasi) ──
# resend.com → API Keys → Create. Domen (ozodflow.uz) Resend'da verify qilinsin
# (SPF/DKIM DNS yozuvlari). "from" domeni verify bo'lmasa email yetib bormaydi.
RESEND_API_KEY=""
EMAIL_FROM="OzodFlow <noreply@ozodflow.uz>"

# ── Pexels (ixtiyoriy) — AI menyu importida TEZ tayyor food rasmlar ──
# pexels.com/api → bepul kalit. Bo'lsa: taomlarga AI generatsiya o'rniga
# avval haqiqiy stock foto qidiriladi (~10x tez). Bo'lmasa AI generatsiya ishlaydi.
PEXELS_API_KEY=""

# ── Telegram bot (admin parolni tiklash uchun) ──
# @BotFather'dan token oling, @userinfobot'dan chat_id oling
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""

# ── inPAY (inpay.uz) onlayn to'lov — Starter/Business tariflari uchun ──
# Kabinet → Kassa (merchant) bo'limidan oling.
INPAY_MERCHANT_ID=""
INPAY_MERCHANT_TOKEN=""
# Ixtiyoriy: webhook imzosini tekshirish uchun SALT (kassa sozlamalarida bo'lsa).
# Bo'sh bo'lsa — imzo tekshirilmaydi, holat inPAY API orqali tasdiqlanadi.
INPAY_WEBHOOK_SALT=""
# Webhook manzili (inPAY kabinetida ko'rsating): https://ozodflow.uz/webhook/tolov

# ── Railway (bitta Volume /app/data ga ulangan) ──
# DATABASE_URL="file:/app/data/prod.db"
# UPLOAD_DIR="/app/data/uploads"
# JWT_SECRET="<uzun-tasodifiy-satr>"
# NEXT_PUBLIC_APP_URL="https://sizning-domeningiz.uz"
# PLATFORM_HOSTS="sizning-domeningiz.uz,www.sizning-domeningiz.uz"

# ── Shaxsiy sayt (Ozodbek's Blog) domeni ──
# Alohida domendan kelgan so'rov ichki /site sahifalariga yo'naltiriladi.
# Bir nechta domen vergul bilan. Bo'sh qoldirsangiz — faqat /site yo'lida ochiladi.
PERSONAL_SITE_HOST=""
