// OzodFlow — restoran elektron menyu SaaS platformasi
// Boshlang'ich DB: SQLite. Kelajakda PostgreSQL'ga o'tish uchun tayyor arxitektura.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Foydalanuvchi va autentifikatsiya
// ─────────────────────────────────────────────
model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  phone     String?  @unique
  name      String
  password  String
  role      String   @default("OWNER") // OWNER | STAFF | ADMIN
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurants     Restaurant[]
  sessions        Session[]
  memberships     Membership[]
  paymentRequests PaymentRequest[]
  domainRequests  DomainRequest[]
  resetCodes      PasswordReset[]
}

// Tarif narxlari (admin paneldan o'zgartiriladi)
model PlanConfig {
  plan      String   @id // PRO | PROMAX
  price     Int
  updatedAt DateTime @updatedAt
}

// Parol tiklash kodi (Telegram bot orqali yuboriladi)
model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────
// Restoran va filiallar
// ─────────────────────────────────────────────
model Restaurant {
  id          String  @id @default(cuid())
  ownerId     String
  slug        String  @unique
  name        String
  description String?
  descriptionRu String?
  descriptionEn String?
  logo        String?
  cover       String?
  phone       String?
  telegram    String?
  instagram   String?
  website     String?
  mapUrl      String?
  address     String?
  workHours   String? // JSON string: ish vaqti
  currency    String  @default("UZS")
  hasDelivery Boolean @default(false)
  payMethods  String? // JSON string: to'lov usullari
  primaryColor String @default("#2563EB")
  menuTheme   String  @default("light") // light | dark | + premium temalar
  customDomain String? @unique // o'z domeni (Pro/Pro Max)
  plan        String  @default("FREE") // FREE | PRO | PROMAX
  planUntil   DateTime? // FREE trial muddati; pullik tariflarda null = umrbod
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner           User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  categories      Category[]
  products        Product[]
  tables          RestaurantTable[]
  scans           ScanEvent[]
  memberships     Membership[]
  paymentRequests PaymentRequest[]
  domainRequests  DomainRequest[]
  orders          Order[]
  banners         Banner[]
  gallery         GalleryImage[]
  serviceCalls    ServiceCall[]
  combos          Combo[]

  @@index([ownerId])
}

// Ofitsiant chaqirish / hisob so'rash
model ServiceCall {
  id           String    @id @default(cuid())
  restaurantId String
  tableCode    String?
  tableName    String?
  type         String // WAITER | BILL
  status       String    @default("ACTIVE") // ACTIVE | DONE
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, status])
}

// Combo (to'plam) taomlar
model Combo {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  nameRu       String?
  nameEn       String?
  price        Float
  oldPrice     Float?
  image        String?
  description  String?
  items        String // JSON: [{productId, name, qty}]
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

// Menyuni hozir ko'rayotganlar (live counter uchun)
model Presence {
  id           String   @id @default(cuid())
  restaurantId String
  visitorId    String
  lastSeen     DateTime @default(now())

  @@unique([restaurantId, visitorId])
  @@index([restaurantId])
}

// Restoran galereyasi (interyer, eksteryer, jamoa)
model GalleryImage {
  id           String   @id @default(cuid())
  restaurantId String
  image        String
  caption      String?
  category     String   @default("interior") // interior | exterior | team | other
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

// Bosh menyu bannerlari (slider)
model Banner {
  id           String   @id @default(cuid())
  restaurantId String
  image        String?
  title        String?
  subtitle     String?
  linkUrl      String?
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

// ─────────────────────────────────────────────
// Buyurtma tizimi
// ─────────────────────────────────────────────
model Order {
  id           String   @id @default(cuid())
  restaurantId String
  number       Int // restoran ichida ketma-ket raqam
  tableCode    String?
  tableName    String?
  phone        String?
  comment      String?
  status       String   @default("NEW") // NEW | ACCEPTED | PREPARING | READY | DELIVERED | CANCELLED
  total        Float    @default(0)
  items        String // JSON: [{productId, name, price, qty}]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, status])
  @@index([createdAt])
}

// Xodimlar / rollar (Business tarif uchun tayyor)
model Membership {
  id           String   @id @default(cuid())
  userId       String
  restaurantId String
  role         String   @default("STAFF") // STAFF | MANAGER
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([userId, restaurantId])
}

// ─────────────────────────────────────────────
// Menyu: kategoriyalar va mahsulotlar
// ─────────────────────────────────────────────
model Category {
  id           String  @id @default(cuid())
  restaurantId String
  name         String
  nameRu       String?
  nameEn       String?
  description  String?
  icon         String?
  sortOrder    Int     @default(0)
  isVisible    Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  products   Product[]

  @@index([restaurantId])
}

model Product {
  id           String  @id @default(cuid())
  restaurantId String
  categoryId   String
  name         String
  nameRu       String?
  nameEn       String?
  description  String?
  descriptionRu String?
  descriptionEn String?
  images       String? // JSON array of image urls
  price        Float   @default(0)
  oldPrice     Float?
  ingredients  String?
  weight       String?
  calories     Int?
  spicyLevel   Int     @default(0) // 0-3
  isVegetarian Boolean @default(false)
  isHalal      Boolean @default(false)
  isNew        Boolean @default(false)
  isBestseller Boolean @default(false)
  isRecommended Boolean @default(false)
  isAvailable  Boolean @default(true)
  isVisible    Boolean @default(true)
  sortOrder    Int     @default(0)
  views        Int     @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category   Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([categoryId])
}

// Har bir stol uchun alohida QR
model RestaurantTable {
  id           String  @id @default(cuid())
  restaurantId String
  name         String
  code         String  @unique
  scans        Int     @default(0)
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

// ─────────────────────────────────────────────
// Statistika: QR skanerlar
// ─────────────────────────────────────────────
model ScanEvent {
  id           String   @id @default(cuid())
  restaurantId String
  tableCode    String?
  visitorId    String? // unique visitors uchun
  userAgent    String?
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// To'lov: qo'lda moderatsiya orqali
// ─────────────────────────────────────────────
// Admin qo'shadigan to'lov kartalari
model PaymentCard {
  id         String   @id @default(cuid())
  bankName   String
  cardNumber String
  cardHolder String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
}

// Foydalanuvchi to'lov so'rovi (chek yuklaydi, admin tasdiqlaydi)
model PaymentRequest {
  id           String    @id @default(cuid())
  restaurantId String
  userId       String
  plan         String // PRO | PROMAX
  months       Int       @default(1) // tanlangan oy soni
  isLifetime   Boolean   @default(false)
  baseAmount   Int       @default(0) // chegirmagacha
  discount     Int       @default(0) // chegirma summasi
  promoCode    String? // ishlatilgan promo kod
  amount       Int // yakuniy summa
  receiptImage String
  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED
  adminNote    String?
  createdAt    DateTime  @default(now())
  reviewedAt   DateTime?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([status])
}

// Promo kodlar (admin yaratadi yoki mijoz yiliga 1 marta oladi)
model PromoCode {
  id              String   @id @default(cuid())
  code            String   @unique
  discountPercent Int // chegirma foizi
  scope           String   @default("ALL") // ALL | PRO | PROMAX
  source          String   @default("ADMIN") // ADMIN | USER
  ownerId         String? // USER kodi kimga tegishli
  maxUses         Int? // null = cheksiz
  usedCount       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([ownerId])
  @@index([source])
}

// Domenni admin orqali ulash so'rovi (40 000 so'm/yil xizmat)
model DomainRequest {
  id           String    @id @default(cuid())
  restaurantId String
  userId       String
  domain       String
  note         String?
  receiptImage String?
  status       String    @default("PENDING") // PENDING | DONE | REJECTED
  adminNote    String?
  createdAt    DateTime  @default(now())
  reviewedAt   DateTime?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([status])
}
