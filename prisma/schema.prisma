// OzodFlow — restoran elektron menyu SaaS platformasi
// Boshlang'ich DB: SQLite. Kelajakda PostgreSQL'ga o'tish uchun tayyor arxitektura.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Foydalanuvchi va autentifikatsiya
// ─────────────────────────────────────────────
model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  phone     String?  @unique
  name      String
  password  String
  role      String   @default("OWNER") // OWNER | STAFF | ADMIN
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurants     Restaurant[]
  sessions        Session[]
  memberships     Membership[]
  paymentRequests PaymentRequest[]
  domainRequests  DomainRequest[]
  resetCodes      PasswordReset[]
}

// Tarif narxlari (admin paneldan o'zgartiriladi)
model PlanConfig {
  plan      String   @id // PRO | PROMAX
  price     Int
  updatedAt DateTime @updatedAt
}

// Parol tiklash kodi (Telegram bot orqali yuboriladi)
model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────
// Restoran va filiallar
// ─────────────────────────────────────────────
model Restaurant {
  id              String    @id @default(cuid())
  ownerId         String
  slug            String    @unique
  name            String
  description     String?
  descriptionRu   String?
  descriptionEn   String?
  logo            String?
  cover           String?
  phone           String?
  telegram        String?
  instagram       String?
  website         String?
  mapUrl          String?
  address         String?
  workHours       String? // JSON string: ish vaqti
  currency        String    @default("UZS")
  hasDelivery     Boolean   @default(false)
  payMethods      String? // JSON string: to'lov usullari
  primaryColor    String    @default("#2563EB")
  menuTheme       String    @default("light") // light | dark | + premium temalar
  purchasedThemes String    @default("[]") // alohida sotib olingan premium dizaynlar (JSON key massivi)
  customDomain    String?   @unique // o'z domeni (Pro/Pro Max)
  plan            String    @default("FREE") // FREE | PRO | PROMAX
  planUntil       DateTime? // FREE trial muddati; pullik tariflarda null = umrbod
  isActive        Boolean   @default(true)
  isBlocked       Boolean   @default(false) // admin tomonidan bloklangan
  blockReason     String? // bloklash sababi (ixtiyoriy)
  overdueNotified DateTime? // to'lov o'tib ketgani haqida adminga oxirgi xabar vaqti
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  owner            User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  categories       Category[]
  products         Product[]
  tables           RestaurantTable[]
  scans            ScanEvent[]
  memberships      Membership[]
  paymentRequests  PaymentRequest[]
  domainRequests   DomainRequest[]
  orders           Order[]
  banners          Banner[]
  gallery          GalleryImage[]
  serviceCalls     ServiceCall[]
  combos           Combo[]
  supportMessages  SupportMessage[]
  posIntegrations  PosIntegration[]
  apiKeys          ApiKey[]
  webhooks         Webhook[]
  instagramAccount InstagramAccount?
  instagramRules   InstagramRule[]
  instagramLogs    InstagramLog[]
  instagramMedia   InstagramMedia[]
  instagramStats   InstagramStatistic[]

  @@index([ownerId])
}

// Restoran egasi ↔ bosh admin yozishmalari (blok, to'lov, aloqa)
model SupportMessage {
  id           String   @id @default(cuid())
  restaurantId String
  topic        String // BLOCK | PAYMENT | CONTACT | GENERAL
  sender       String // OWNER | ADMIN | VISITOR
  body         String
  contact      String? // ommaviy tashrifchi aloqa ma'lumoti
  isRead       Boolean  @default(false)
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([isRead])
}

// Ofitsiant chaqirish / hisob so'rash
model ServiceCall {
  id           String    @id @default(cuid())
  restaurantId String
  tableCode    String?
  tableName    String?
  type         String // WAITER | BILL
  status       String    @default("ACTIVE") // ACTIVE | DONE
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, status])
}

// Combo (to'plam) taomlar
model Combo {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  nameRu       String?
  nameEn       String?
  price        Float
  oldPrice     Float?
  image        String?
  description  String?
  items        String // JSON: [{productId, name, qty}]
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

// Menyuni hozir ko'rayotganlar (live counter uchun)
model Presence {
  id           String   @id @default(cuid())
  restaurantId String
  visitorId    String
  lastSeen     DateTime @default(now())

  @@unique([restaurantId, visitorId])
  @@index([restaurantId])
}

// Restoran galereyasi (interyer, eksteryer, jamoa)
model GalleryImage {
  id           String   @id @default(cuid())
  restaurantId String
  image        String
  caption      String?
  category     String   @default("interior") // interior | exterior | team | other
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

// Bosh menyu bannerlari (slider)
model Banner {
  id           String   @id @default(cuid())
  restaurantId String
  image        String?
  title        String?
  subtitle     String?
  linkUrl      String?
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

// ─────────────────────────────────────────────
// Buyurtma tizimi
// ─────────────────────────────────────────────
model Order {
  id           String   @id @default(cuid())
  restaurantId String
  number       Int // restoran ichida ketma-ket raqam
  tableCode    String?
  tableName    String?
  phone        String?
  comment      String?
  status       String   @default("NEW") // NEW | ACCEPTED | PREPARING | READY | DELIVERED | CANCELLED
  total        Float    @default(0)
  items        String // JSON: [{productId, name, price, qty}]
  // ─── POS ga yuborish holati ───
  posOrderId   String? // POS tizimidagi buyurtma ID (yuborilgan bo'lsa)
  posError     String? // POS ga yuborishda xato (bo'lsa)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, status])
  @@index([createdAt])
}

// Xodimlar / rollar (Business tarif uchun tayyor)
model Membership {
  id           String   @id @default(cuid())
  userId       String
  restaurantId String
  role         String   @default("STAFF") // STAFF | MANAGER
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([userId, restaurantId])
}

// ─────────────────────────────────────────────
// Menyu: kategoriyalar va mahsulotlar
// ─────────────────────────────────────────────
model Category {
  id            String   @id @default(cuid())
  restaurantId  String
  name          String
  nameRu        String?
  nameEn        String?
  description   String?
  icon          String?
  sortOrder     Int      @default(0)
  isVisible     Boolean  @default(true)
  // ─── POS integratsiya ───
  posProvider   String? // CLOPOS | IIKO | POSTER | JOWI | RKEEPER
  posExternalId String? // provayderdagi kategoriya ID
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  products   Product[]

  @@unique([restaurantId, posProvider, posExternalId])
  @@index([restaurantId])
}

model Product {
  id            String   @id @default(cuid())
  restaurantId  String
  categoryId    String
  name          String
  nameRu        String?
  nameEn        String?
  description   String?
  descriptionRu String?
  descriptionEn String?
  images        String? // JSON array of image urls
  price         Float    @default(0)
  oldPrice      Float?
  ingredients   String?
  weight        String?
  calories      Int?
  spicyLevel    Int      @default(0) // 0-3
  isVegetarian  Boolean  @default(false)
  isHalal       Boolean  @default(false)
  isNew         Boolean  @default(false)
  isBestseller  Boolean  @default(false)
  isRecommended Boolean  @default(false)
  isAvailable   Boolean  @default(true)
  isVisible     Boolean  @default(true)
  sortOrder     Int      @default(0)
  views         Int      @default(0)
  // ─── POS integratsiya (tashqi tizim bilan bog'lash) ───
  posProvider   String? // CLOPOS | IIKO | POSTER | JOWI | RKEEPER
  posExternalId String? // provayderdagi mahsulot ID
  stockStatus   String? // IN_STOCK | OUT_OF_STOCK | LOW
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category   Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, posProvider, posExternalId])
  @@index([restaurantId])
  @@index([categoryId])
}

// Har bir stol uchun alohida QR
model RestaurantTable {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  code         String   @unique
  scans        Int      @default(0)
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

// ─────────────────────────────────────────────
// Statistika: QR skanerlar
// ─────────────────────────────────────────────
model ScanEvent {
  id           String   @id @default(cuid())
  restaurantId String
  tableCode    String?
  visitorId    String? // unique visitors uchun
  userAgent    String?
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// To'lov: qo'lda moderatsiya orqali
// ─────────────────────────────────────────────
// Admin qo'shadigan to'lov kartalari
model PaymentCard {
  id         String   @id @default(cuid())
  bankName   String
  cardNumber String
  cardHolder String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
}

// Bosh sahifa ko'rsatkichlari (500+ restoran, 1M+ skan ...) — admin boshqaradi
model SiteStat {
  id        String   @id @default(cuid())
  value     String
  label     String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([isActive])
}

// Bosh sahifa hamkorlari (logolar tasmasi)
model Partner {
  id        String   @id @default(cuid())
  name      String
  image     String
  url       String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([isActive])
}

// Foydalanuvchi to'lov so'rovi (chek yuklaydi, admin tasdiqlaydi)
model PaymentRequest {
  id           String    @id @default(cuid())
  restaurantId String
  userId       String
  kind         String    @default("PLAN") // PLAN = tarif, THEME = alohida dizayn
  plan         String // tarif kaliti (THEME uchun — joriy tarif)
  themeKey     String? // THEME turida sotib olinayotgan dizayn kaliti
  months       Int       @default(1) // tanlangan oy soni
  isLifetime   Boolean   @default(false)
  baseAmount   Int       @default(0) // chegirmagacha
  discount     Int       @default(0) // chegirma summasi
  promoCode    String? // ishlatilgan promo kod
  amount       Int // yakuniy summa
  receiptImage String
  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED
  adminNote    String?
  createdAt    DateTime  @default(now())
  reviewedAt   DateTime?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([status])
}

// Promo kodlar (admin yaratadi yoki mijoz yiliga 1 marta oladi)
model PromoCode {
  id              String   @id @default(cuid())
  code            String   @unique
  discountPercent Int // chegirma foizi
  scope           String   @default("ALL") // ALL | PRO | PROMAX
  source          String   @default("ADMIN") // ADMIN | USER
  ownerId         String? // USER kodi kimga tegishli
  maxUses         Int? // null = cheksiz
  usedCount       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([ownerId])
  @@index([source])
}

// Domenni admin orqali ulash so'rovi (40 000 so'm/yil xizmat)
model DomainRequest {
  id           String    @id @default(cuid())
  restaurantId String
  userId       String
  domain       String
  note         String?
  receiptImage String?
  status       String    @default("PENDING") // PENDING | DONE | REJECTED
  adminNote    String?
  createdAt    DateTime  @default(now())
  reviewedAt   DateTime?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([status])
}

// ─────────────────────────────────────────────
// POS integratsiya (Clopos, iiko, Poster, JOWI, R-Keeper ...)
// Provayderga bog'liq bo'lmagan umumiy modellar
// ─────────────────────────────────────────────
model PosIntegration {
  id              String    @id @default(cuid())
  restaurantId    String
  provider        String // CLOPOS | IIKO | POSTER | JOWI | RKEEPER
  credentials     String // AES-256-GCM shifrlangan JSON (hech qachon ochiq saqlanmaydi)
  isActive        Boolean   @default(true)
  autoSync        Boolean   @default(true)
  syncIntervalMin Int       @default(5)
  status          String    @default("PENDING") // PENDING | CONNECTED | ERROR
  lastError       String?
  lastSyncAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  restaurant Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  syncLogs   PosSyncLog[]

  @@unique([restaurantId, provider])
  @@index([restaurantId])
}

model PosSyncLog {
  id            String   @id @default(cuid())
  integrationId String
  type          String // MENU | ORDER_PUSH | ORDER_STATUS
  status        String // SUCCESS | FAILED | PARTIAL
  itemsSynced   Int      @default(0)
  itemsFailed   Int      @default(0)
  message       String?
  durationMs    Int?
  createdAt     DateTime @default(now())

  integration PosIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// Tashqi (hamkor) API kalitlari — /api/v1 uchun
// Sir (secret) ochiq saqlanmaydi: faqat SHA-256 hash.
// ─────────────────────────────────────────────
model ApiKey {
  id           String    @id @default(cuid())
  restaurantId String
  name         String
  prefix       String    @unique // ko'rsatish + tez qidiruv: ozf_live_xxxx
  hash         String // SHA-256(to'liq kalit)
  scopes       String    @default("menu:read") // JSON yoki vergul bilan
  isActive     Boolean   @default(true)
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

// ─────────────────────────────────────────────
// Chiquvchi webhooklar — buyurtma hodisalarini restoran serveriga yuborish
// Har yuborish HMAC-SHA256 imzo bilan (X-OzodFlow-Signature).
// ─────────────────────────────────────────────
model Webhook {
  id             String    @id @default(cuid())
  restaurantId   String
  url            String
  secret         String // HMAC imzo kaliti
  events         String    @default("[\"order.created\"]") // JSON massiv
  isActive       Boolean   @default(true)
  lastStatus     Int?
  lastError      String?
  lastDeliveryAt DateTime?
  createdAt      DateTime  @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

// ═════════════════════════════════════════════
// Instagram Automation — marketing avtomatlashtirish
// Instagram Graph API (Messenger Platform + Webhooks) orqali ishlaydi.
// Token'lar DB'da AES-256-GCM bilan shifrlanadi (lib/instagram/token.ts).
// ═════════════════════════════════════════════

// Ulangan Instagram Business/Creator akkaunti (restoranga 1:1)
model InstagramAccount {
  id             String    @id @default(cuid())
  restaurantId   String    @unique
  igUserId       String    @unique // Instagram Graph API user id
  username       String
  name           String?
  profilePicture String?
  followers      Int       @default(0)
  following      Int       @default(0)
  mediaCount     Int       @default(0)
  tokens         String // Shifrlangan {token, refresh?} — v1:iv:tag:data
  tokenExpiresAt DateTime? // long-lived token muddati (~60 kun)
  status         String    @default("CONNECTED") // CONNECTED | ERROR | DISCONNECTED
  lastError      String?
  lastSyncAt     DateTime?
  connectedAt    DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

// Avtomatlashtirish qoidasi
model InstagramRule {
  id            String   @id @default(cuid())
  restaurantId  String
  name          String
  trigger       String   @default("COMMENT_DM") // COMMENT | DM | COMMENT_DM
  matchType     String   @default("CONTAINS") // CONTAINS | EQUALS | STARTS_WITH | ENDS_WITH
  caseSensitive Boolean  @default(false)
  enabled       Boolean  @default(true)
  priority      Int      @default(1) // kichik raqam = yuqori ustuvorlik
  scope         String   @default("GLOBAL") // GLOBAL | POST
  postId        String? // scope=POST bo'lsa Instagram media id
  postCaption   String? // UI'da ko'rsatish uchun
  commentReply  String? // comment'ga ochiq javob matni
  delaySec      Int      @default(0)
  randomDelay   Boolean  @default(false)
  cooldownHours Int      @default(24) // smart filter: userga N soatda 1 marta
  schedule      String? // JSON: {mode, from, to, days, tz}
  hitCount      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  restaurant Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  keywords   InstagramKeyword[]
  messages   InstagramMessage[]
  logs       InstagramLog[]

  @@index([restaurantId])
  @@index([postId])
}

// Qoidaga bog'langan keyword (har biri alohida qator)
model InstagramKeyword {
  id       String  @id @default(cuid())
  ruleId   String
  word     String
  isIgnore Boolean @default(false) // true = ignore ro'yxati

  rule InstagramRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
}

// DM flow xabari (ko'p bosqichli — step tartibi bilan)
model InstagramMessage {
  id       String  @id @default(cuid())
  ruleId   String
  step     Int     @default(0) // flow tartibi (0 = birinchi)
  kind     String  @default("TEXT") // TEXT | IMAGE | VIDEO
  body     String? // matn (**bold**, qator, emoji)
  mediaUrl String? // IMAGE/VIDEO uchun
  delaySec Int     @default(0)

  rule    InstagramRule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  buttons InstagramButton[]

  @@index([ruleId])
}

// DM xabaridagi tugma (Instagram: max 3 tugma, url yoki postback)
model InstagramButton {
  id         String  @id @default(cuid())
  messageId  String
  label      String
  actionType String  @default("URL") // URL | NEXT_STEP | POSTBACK
  actionUrl  String? // URL uchun
  nextStep   Int? // NEXT_STEP uchun (flow keyingi step)
  payload    String? // POSTBACK uchun
  clicks     Int     @default(0)
  sortOrder  Int     @default(0)

  message InstagramMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

// Media kutubxonasi (DM'da qayta ishlatish uchun)
model InstagramMedia {
  id           String   @id @default(cuid())
  restaurantId String
  kind         String   @default("IMAGE") // IMAGE | VIDEO | PDF
  url          String
  title        String?
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

// Har bir avtomatlashtirish yozuvi (audit + qidiruv)
model InstagramLog {
  id           String   @id @default(cuid())
  restaurantId String
  ruleId       String?
  trigger      String // COMMENT | DM
  igUsername   String?
  igUserId     String? // IGSID (DM yuborish uchun)
  mediaId      String? // qaysi post
  commentId    String?
  commentText  String?
  replyText    String? // yuborilgan javob (comment yoki DM)
  status       String   @default("SENT") // SENT | SKIPPED | FAILED | PENDING
  reason       String? // SKIPPED/FAILED sababi
  createdAt    DateTime @default(now())

  restaurant Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  rule       InstagramRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([ruleId])
  @@index([createdAt])
}

// Webhook hodisalari (idempotentlik uchun)
model InstagramEvent {
  id        String   @id @default(cuid())
  eventKey  String   @unique // dedup kaliti (comment_id yoki message mid)
  type      String // COMMENT | MESSAGE
  igUserId  String?
  payload   String // xom JSON
  processed Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Smart filter: userga oxirgi javob vaqti (cooldown uchun)
model InstagramInteraction {
  id            String   @id @default(cuid())
  restaurantId  String
  igUserId      String
  ruleId        String?
  lastRepliedAt DateTime @default(now())

  @@unique([restaurantId, igUserId, ruleId])
  @@index([restaurantId])
}

// Kunlik statistika (agregat — grafik uchun)
model InstagramStatistic {
  id           String @id @default(cuid())
  restaurantId String
  date         String // YYYY-MM-DD
  comments     Int    @default(0)
  dms          Int    @default(0)
  replies      Int    @default(0)
  buttonClicks Int    @default(0)
  newFollowers Int    @default(0)
  conversions  Int    @default(0)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, date])
  @@index([restaurantId])
}
